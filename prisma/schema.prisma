generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime connection — point this at Supabase's pooled ("Transaction")
  // connection string. The app/worker hold it open long-term, so pooling
  // keeps us from exhausting Supabase's connection limit.
  url       = env("DATABASE_URL")
  // Supabase's pooler (PgBouncer, transaction mode) doesn't support the
  // prepared statements/advisory locks `prisma migrate` needs, so
  // migrations run over a direct (non-pooled) connection instead — same
  // database, different connection string. See .env.example.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  // Null until the confirmation link (see /api/verify-email) is clicked.
  // Signed-in access never depends on this being set — unverified accounts
  // can sign in and use their trial same as any other — it only drives
  // whether the studio shows a "confirm your email" nudge.
  emailVerifiedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  creditBalance            CreditBalance?
  subscription             Subscription?
  generationJobs           GenerationJob[]
  emailVerificationTokens  EmailVerificationToken[]
}

// A single-use link sent by /api/register (and re-issuable via POST
// /api/verify-email/resend) to confirm an account's email address. Only
// tokenHash is ever stored — the raw token lives in the emailed link and
// nowhere else, so a database read alone can't be used to confirm an
// account. /api/verify-email deletes every row for a user once one of
// theirs is successfully used, so a stale earlier link stops working too.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model CreditBalance {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

enum PlanTier {
  TRIAL
  STARTER
  CREATOR
  PRO
  STUDIO
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Stays STARTER (an enum value that already existed before this round of
  // changes) rather than TRIAL on purpose: Postgres refuses to let a single
  // migration both add a new enum value and use it as a column default in
  // the same transaction ("new enum values must be committed before they
  // can be used"). This column default is just a fallback anyway — every
  // real signup explicitly sets planTier: "TRIAL" itself, see
  // src/app/api/register/route.ts.
  planTier             PlanTier  @default(STARTER)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String?
  // Start of the *current* credit period — for TRIAL this is set once at
  // signup and never moves (the 7-day trial only ever has one period); for
  // paid tiers it's rolled forward lazily (see src/lib/plans.ts) each time
  // a monthly period elapses. currentPeriodEnd is derived from this plus
  // the plan's period length, but we also persist it so it's readable
  // directly from Supabase Studio/SQL without re-implementing the logic.
  currentPeriodStart   DateTime  @default(now())
  currentPeriodEnd     DateTime?
  // Set automatically (by a DB trigger — see the add_first_paid_at
  // migration) the first time this account's planTier moves off TRIAL onto
  // any paid tier. Stays null for accounts still on (or that never left)
  // the free trial. This is what lets admin_user_insights report "when did
  // they become a paying customer" even though there's no billing/payment
  // flow yet — today that transition only happens via a manual edit in
  // Supabase's Table Editor, and the trigger catches it there too.
  firstPaidAt          DateTime?
  // Lifecycle-email bookkeeping for TRIAL accounts (see the worker's hourly
  // lifecycle-emails job) — each stamped the first time its email actually
  // goes out, so a repeat run of the hourly scan never sends either one
  // twice. Both stay null for any account that reaches a paid tier before
  // its trial would have ended.
  trialReminderSentAt   DateTime?
  trialEndedEmailSentAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model GenerationJob {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         JobStatus @default(QUEUED)
  provider       String?
  providerJobId  String?
  prompt         String
  costCents      Int?
  resultUrl      String?
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
}
