# Copy this file to .env and fill in real values.
# Never commit the real .env file — add it to .gitignore.

# ── App ──────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ── Database (Postgres via Supabase) ─────────────
# Get both of these from your Supabase project: Project Settings →
# Database → Connection string. That page offers a few variants — pick:
#
# DATABASE_URL — the "Transaction pooler" string (port 6543). The app and
# worker hold this connection open long-term, so pooling keeps you from
# running into Supabase's connection-count limit.
DATABASE_URL=postgresql://postgres.placeholder:placeholder_password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# DIRECT_URL — the "Direct connection" string (port 5432, no pgbouncer).
# Only `npx prisma migrate ...` uses this, and only while actually running
# a migration — Supabase's pooler can't do the prepared statements/locks
# migrations need. Same database, different connection string.
DIRECT_URL=postgresql://postgres.placeholder:placeholder_password@db.placeholder.supabase.co:5432/postgres

# ── Job queue (Redis) ─────────────────────────────
REDIS_URL=redis://redis:6379

# ── Auth ──────────────────────────────────────────
# A long random string used to sign sessions/tokens. Generate one with:
# openssl rand -base64 48
AUTH_SECRET=replace_with_a_long_random_string
# Required by Auth.js when running behind a reverse proxy (Caddy).
AUTH_TRUST_HOST=true

# ── Stripe ────────────────────────────────────────
# Use your test-mode keys until you're ready to go live.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
# From Stripe Dashboard → Developers → Webhooks → your endpoint → "Signing
# secret". Only needed once the endpoint below is actually configured there.
STRIPE_WEBHOOK_SECRET=whsec_placeholder
# One Price ID per paid tier — Stripe Dashboard → Product catalog → click a
# product → copy the ID that starts with "price_" underneath its price, NOT
# the Product ID (starts with "prod_"). Test mode and live mode each have
# their own separate IDs, so these need updating again when you switch.
STRIPE_PRICE_STARTER=price_placeholder
STRIPE_PRICE_CREATOR=price_placeholder
STRIPE_PRICE_PRO=price_placeholder
STRIPE_PRICE_STUDIO=price_placeholder

# ── Object storage (Hetzner Object Storage, S3-compatible) ──
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=placeholder-bucket-name
S3_ACCESS_KEY_ID=placeholder_access_key
S3_SECRET_ACCESS_KEY=placeholder_secret_key

# ── AI video providers ────────────────────────────
# Add/remove lines here as you actually sign up for each one. Each one maps
# to an adapter in src/lib/video-providers/ — see MODEL_TO_PROVIDER in
# src/lib/video-providers/index.ts for which studio model uses which.
OPENAI_API_KEY=sk-placeholder
LUMA_API_KEY=luma-placeholder
RUNWAY_API_KEY=runway-placeholder
GOOGLE_VEO_API_KEY=veo-placeholder
# Kling — most accounts created at kling.ai/dev/api-key now get a single
# API key (used as a bearer token). Set only KLING_API_KEY in that case.
KLING_API_KEY=kling-api-key-placeholder
# Older accounts may instead have an Access Key + Secret Key pair — only
# needed if you don't have a KLING_API_KEY above.
KLING_ACCESS_KEY=kling-access-key-placeholder
KLING_SECRET_KEY=kling-secret-key-placeholder
# fal.ai — one key covers every fal-* provider registered in
# src/lib/video-providers/fal.ts (FAL_MODEL_IDS).
FAL_API_KEY=fal-placeholder
# Higgsfield — its own developer API (api.higgsfield.ai), separate from
# fal.ai. Get a key at console.higgsfield.ai — it's issued as a single value
# already formatted as "key-id:key-secret"; paste the whole thing here as-is.
# Covers every model registered in src/lib/video-providers/higgsfield.ts
# (HIGGSFIELD_MODEL_PATHS), e.g. Genjutsu.
HIGGSFIELD_API_KEY=higgsfield-key-placeholder
# Only needed if your account instead issued the id/secret as two separate
# values (rare) — leave unset if HIGGSFIELD_API_KEY above is set.
HIGGSFIELD_API_KEY_ID=higgsfield-key-id-placeholder
HIGGSFIELD_API_KEY_SECRET=higgsfield-key-secret-placeholder
