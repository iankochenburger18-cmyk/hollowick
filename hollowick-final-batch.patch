Subject: [PATCH 4/4] Support Higgsfield's single combined API key alongside
 separate id/secret

---
 .env.example                          | 10 +++++++---
 src/lib/video-providers/higgsfield.ts | 22 +++++++++++++++-------
 2 files changed, 22 insertions(+), 10 deletions(-)

diff --git a/.env.example b/.env.example
index a088764..eec4d42 100644
--- a/.env.example
+++ b/.env.example
@@ -52,8 +52,12 @@ KLING_SECRET_KEY=kling-secret-key-placeholder
 # src/lib/video-providers/fal.ts (FAL_MODEL_IDS).
 FAL_API_KEY=fal-placeholder
 # Higgsfield — its own developer API (api.higgsfield.ai), separate from
-# fal.ai. Get a key pair at console.higgsfield.ai. Covers every model
-# registered in src/lib/video-providers/higgsfield.ts (HIGGSFIELD_MODEL_PATHS),
-# e.g. Genjutsu.
+# fal.ai. Get a key at console.higgsfield.ai — it's issued as a single value
+# already formatted as "key-id:key-secret"; paste the whole thing here as-is.
+# Covers every model registered in src/lib/video-providers/higgsfield.ts
+# (HIGGSFIELD_MODEL_PATHS), e.g. Genjutsu.
+HIGGSFIELD_API_KEY=higgsfield-key-placeholder
+# Only needed if your account instead issued the id/secret as two separate
+# values (rare) — leave unset if HIGGSFIELD_API_KEY above is set.
 HIGGSFIELD_API_KEY_ID=higgsfield-key-id-placeholder
 HIGGSFIELD_API_KEY_SECRET=higgsfield-key-secret-placeholder
diff --git a/src/lib/video-providers/higgsfield.ts b/src/lib/video-providers/higgsfield.ts
index a4b73a1..aa9bf8d 100644
--- a/src/lib/video-providers/higgsfield.ts
+++ b/src/lib/video-providers/higgsfield.ts
@@ -34,16 +34,24 @@ interface HiggsfieldStatusResponse {
   error?: string;
 }
 
+// console.higgsfield.ai currently issues ONE key that already comes
+// formatted as "<key-id>:<key-secret>" (its own setup snippet says
+// HF_KEY=your-api-key-id:your-api-key-secret) — you copy that whole string
+// as a single value, there's no separate secret field to grab. Some accounts
+// may instead be issued the id/secret as two separate values, so fall back
+// to combining those if that's what's set.
 function requireAuthHeader(): string {
+  const singleKey = process.env.HIGGSFIELD_API_KEY;
+  if (singleKey) return `Key ${singleKey}`;
+
   const keyId = process.env.HIGGSFIELD_API_KEY_ID;
   const keySecret = process.env.HIGGSFIELD_API_KEY_SECRET;
-  if (!keyId || !keySecret) {
-    throw new VideoProviderError(
-      "HIGGSFIELD_API_KEY_ID and HIGGSFIELD_API_KEY_SECRET must both be set — get a key pair from console.higgsfield.ai",
-      "missing_api_key"
-    );
-  }
-  return `Key ${keyId}:${keySecret}`;
+  if (keyId && keySecret) return `Key ${keyId}:${keySecret}`;
+
+  throw new VideoProviderError(
+    "No Higgsfield credentials set — set HIGGSFIELD_API_KEY to the single key from console.higgsfield.ai (already formatted as key-id:key-secret), or HIGGSFIELD_API_KEY_ID + HIGGSFIELD_API_KEY_SECRET if your account issued them separately",
+    "missing_api_key"
+  );
 }
 
 async function higgsfieldRequest<T>(url: string, init: RequestInit): Promise<T> {
