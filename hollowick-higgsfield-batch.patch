+  "MiniMax Hailuo": "minimax-hailuo-2.3",
+  "LTX 2.5 Fast": "ltx-2.5-fast",
+  "LTX 2.5 Pro": "ltx-2.5-pro",
+  "Happy Horse 1.1": "happy-horse-1.1",
+  "Happy Horse 1.0": "happy-horse-1.0",
 };
 
